@keyframes proposeIn { 
  0% { opacity: 0; transform: translateY(-8px); }
  100% { opacity: 1; transform: none; }
}

.respond-bar .offer-blue, .budget-box .respond-bar .offer-blue { background: var(--at-blue,#1f6fe5); color: rgb(255, 255, 255); border: 0px; font-weight: 700; box-shadow: rgba(31, 111, 229, 0.28) 0px 6px 16px; }

.respond-bar .offer-blue:hover { background: var(--at-blue-d,#1757b8); }

.modal .bubble, .modal .bubble div { font-size: 14px !important; line-height: 1.5 !important; color: rgb(0, 0, 0) !important; }

.modal .bubble small { font-size: 11px !important; color: rgb(51, 51, 51) !important; }

.modal .chat-compose input { font-size: 14px !important; color: rgb(0, 0, 0) !important; }

.modal .chat-compose input::placeholder { color: rgb(85, 85, 85) !important; }

.modal .empty-chat, .modal .privacy-hint { font-size: 13px !important; color: rgb(0, 0, 0) !important; }

.modal .chat-title b { font-size: 15px !important; color: rgb(0, 0, 0) !important; }

.modal .oc-msg { font-size: 14px !important; line-height: 1.5 !important; color: rgb(0, 0, 0) !important; }

.modal .oc-foot small, .modal .oc-who small { font-size: 12px !important; color: rgb(34, 34, 34) !important; }

.modal .oc-avail { font-size: 14px !important; color: rgb(0, 0, 0) !important; }

.price-pin.done { background: rgb(107, 116, 144); }

.price-pin.done::after { border-top-color: rgb(107, 116, 144); }

.browse .task-card.is-done { background: rgb(247, 250, 248); border-color: rgb(213, 236, 221); }

.tc-open.done { color: rgb(19, 122, 63); }

.chip.completed, .chip.done, .chip.closed { background: rgb(227, 246, 234); color: rgb(23, 112, 58); }
