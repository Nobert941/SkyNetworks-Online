@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap");

:root { --navy: #071d3c; --blue: #123e78; --bright: #2d75d7; --pale: #eaf2fc; --ink: #13233b; --muted: #6c7b90; --line: #e4eaf1; --white: #fff; --gold: #f3b84b; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; color: var(--ink); font-family: "DM Sans", sans-serif; background: rgb(255, 255, 255); }

a { color: inherit; text-decoration: none; }

.topbar { height: 82px; padding: 0px 6.5%; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); background: rgb(255, 255, 255); position: sticky; top: 0px; z-index: 10; }

.brand { display: flex; gap: 10px; align-items: center; font-family: Manrope; font-weight: 800; font-size: 20px; color: var(--navy); line-height: 1; }

.brand-mark { width: 38px; height: 38px; border-radius: 12px; background: var(--navy); color: rgb(255, 255, 255); display: grid; place-items: center; font-size: 22px; }

.brand-light { font-weight: 500; color: var(--bright); }

.brand small { display: block; font: 700 8px "DM Sans"; letter-spacing: 1.45px; color: rgb(130, 144, 162); margin-top: 5px; }

.topbar nav { display: flex; gap: 30px; font-size: 13px; font-weight: 600; color: rgb(83, 100, 123); }

.topbar nav a:hover, footer a:hover { color: var(--bright); }

.top-actions { display: flex; gap: 18px; align-items: center; }

.text-btn, .menu-btn { border: 0px; background: none; color: var(--navy); font-weight: 700; cursor: pointer; }

.menu-btn { display: none; }

.primary { border: 0px; background: var(--bright); color: rgb(255, 255, 255); border-radius: 8px; padding: 15px 23px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: rgba(45, 117, 215, 0.16) 0px 7px 18px; }

.primary:hover { background: rgb(30, 97, 184); transform: translateY(-1px); }

.primary span { margin-left: 16px; }

.primary.small { padding: 11px 18px; font-size: 13px; }

.hero { background: linear-gradient(112deg, rgb(245, 248, 253) 0%, rgb(241, 246, 253) 55%, rgb(229, 239, 252) 100%); padding: 85px 9% 80px; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 5%; }

.eyebrow { font-size: 10px; letter-spacing: 1.8px; color: var(--bright); font-weight: 800; }

.eyebrow span { display: inline-block; width: 7px; height: 7px; background: rgb(50, 181, 138); border-radius: 50%; margin-right: 7px; }

.hero h1 { font: 800 clamp(42px, 5vw, 66px) / 1.1 Manrope; color: var(--navy); letter-spacing: -2.5px; margin: 22px 0px; }

.hero h1 em, .trust h2 em { color: var(--bright); font-style: normal; }

.hero-copy > p { font-size: 17px; line-height: 1.7; color: rgb(99, 115, 138); max-width: 470px; }

.hero-buttons { display: flex; align-items: center; gap: 26px; margin: 28px 0px 42px; }

.secondary { font-size: 14px; font-weight: 700; border-bottom: 1px solid rgb(156, 174, 195); padding-bottom: 5px; }

.proof { display: flex; align-items: center; gap: 15px; font-size: 11px; color: rgb(120, 134, 154); line-height: 1.5; }

.proof strong { color: rgb(38, 60, 89); }

.avatars { display: flex; padding-left: 5px; }

.avatars b { width: 32px; height: 32px; border: 2px solid rgb(244, 248, 253); background: rgb(198, 216, 239); border-radius: 50%; display: grid; place-items: center; font-size: 9px; color: rgb(23, 62, 112); margin-left: -5px; }

.avatars b:nth-child(2) { background: rgb(217, 200, 182); }

.avatars b:nth-child(3) { background: rgb(185, 217, 208); }

.hero-art { position: relative; padding: 20px; }

.map-card { background: rgb(255, 255, 255); border-radius: 16px; padding: 17px; box-shadow: rgba(24, 58, 101, 0.11) 0px 22px 60px; transform: rotate(1deg); }

.map-top, .map-foot { display: flex; justify-content: space-between; font-size: 9px; letter-spacing: 1.1px; font-weight: 800; color: rgb(135, 149, 168); }

.live-dot { color: rgb(38, 164, 122); }

.map-grid { height: 310px; margin: 14px 0px; background-color: rgb(233, 240, 232); background-image: linear-gradient(35deg, transparent 47%, rgb(255, 255, 255) 48%, rgb(255, 255, 255) 51%, transparent 52%), linear-gradient(110deg, transparent 46%, rgb(255, 255, 255) 47%, rgb(255, 255, 255) 50%, transparent 51%), linear-gradient(0deg, rgb(216, 231, 216) 1px, transparent 1px), linear-gradient(90deg, rgb(216, 231, 216) 1px, transparent 1px); background-size: 100% 100%, 100% 100%, 42px 42px, 42px 42px; position: relative; overflow: hidden; border-radius: 9px; }

.road { position: absolute; background: rgb(255, 255, 255); opacity: 0.9; height: 8px; width: 120%; transform: rotate(-24deg); top: 45%; left: -10%; }

.r2 { transform: rotate(54deg); top: 40%; left: -10%; height: 6px; }

.r3 { transform: rotate(8deg); top: 75%; height: 5px; }

