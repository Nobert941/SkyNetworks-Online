:root { --at-ink: #0f1b4d; --at-blue: #1f6fe5; --at-blue-d: #1757b8; --at-bg: #f2f3f7; --at-line: #e3e6ee; --at-muted: #6b7490; --head-h: 64px; }

body { font-family: "DM Sans", system-ui, sans-serif; color: var(--at-ink); }

.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); }

.topbar { height: var(--head-h); padding: 0px 24px; gap: 20px; justify-content: flex-start; box-shadow: 0 1px 0 var(--at-line); border-bottom: 0px; }

.brand-mark { width: 34px; height: 34px; border-radius: 10px; background: var(--at-blue); font-size: 20px; }

.brand { font-size: 21px; color: var(--at-ink); }

.brand-light { color: var(--at-blue); }

.post-pill { border: 0px; background: var(--at-blue); color: rgb(255, 255, 255); font: 700 14px "DM Sans"; padding: 10px 22px; border-radius: 999px; cursor: pointer; white-space: nowrap; }

.post-pill:hover { background: var(--at-blue-d); }

.topbar nav { margin-right: auto; gap: 4px; font-size: 14px; font-weight: 600; color: var(--at-ink); }

.topbar nav a { padding: 8px 12px; border-radius: 8px; }

.topbar nav a:hover { background: var(--at-bg); color: var(--at-ink); }

.top-actions { gap: 6px; }

.top-actions .text-btn { font: 600 14px "DM Sans"; padding: 9px 14px; border-radius: 999px; color: var(--at-ink); }

.top-actions .text-btn:hover { background: var(--at-bg); }

.top-actions .text-btn.login { border: 1px solid var(--at-ink); }

.hero { padding: 48px 6% 44px; background: rgb(255, 255, 255); border-bottom: 1px solid var(--at-line); grid-template-columns: 1.05fr 0.95fr; gap: 48px; }

.hero h1 { font: 800 clamp(34px, 4.4vw, 54px) / 1.08 Manrope; letter-spacing: -1.5px; margin: 0px 0px 16px; color: var(--at-ink); }

.hero h1 em { color: var(--at-blue); }

.hero-copy > p { font-size: 18px; color: var(--at-muted); margin: 0px; }

.hero-buttons { margin: 26px 0px 28px; }

.hero .primary { border-radius: 999px; padding: 14px 28px; box-shadow: none; background: var(--at-blue); }

.hero .primary:hover { background: var(--at-blue-d); transform: none; }

.hero .secondary { border: 1px solid var(--at-ink); border-radius: 999px; padding: 13px 26px; font-weight: 700; }

.hero-stats { display: flex; gap: 32px; list-style: none; padding: 0px; margin: 0px; }

.hero-stats li { display: flex; flex-direction: column; font-size: 13px; color: var(--at-muted); }

.hero-stats b { font: 800 20px Manrope; color: var(--at-ink); }

.hero-art { padding: 0px; }

.hero-map { height: 300px; min-height: 300px; border-radius: 16px; border: 1px solid var(--at-line); }

.browse { padding: 0px; background: var(--at-bg); scroll-margin-top: var(--head-h); }

.filter-bar { display: flex; gap: 8px; align-items: center; padding: 12px 16px; background: rgb(255, 255, 255); border-bottom: 1px solid var(--at-line); overflow-x: auto; scrollbar-width: none; position: sticky; top: var(--head-h); z-index: 5; }

.filter-bar::-webkit-scrollbar { display: none; }

.pill { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0px 14px; border: 1px solid var(--at-line); border-radius: 999px; background: rgb(255, 255, 255); font: 600 14px "DM Sans"; color: var(--at-ink); white-space: nowrap; flex: 0 0 auto; cursor: pointer; }

.pill:hover { border-color: var(--at-ink); }

.pill:focus-within { border-color: var(--at-blue); box-shadow: rgba(31, 111, 229, 0.133) 0px 0px 0px 3px; }

.pill input { border: 0px; outline: 0px; background: none; font: 500 14px "DM Sans"; color: var(--at-ink); width: 150px; min-width: 0px; }

.pill .ico { color: var(--at-muted); font-size: 17px; }

.pill select { border: 0px; outline: 0px; background: none; font: 600 14px "DM Sans"; color: var(--at-ink); cursor: pointer; padding: 0px 2px; max-width: 190px; }

.clear-pill { color: var(--at-blue); border-color: transparent; }

.clear-pill:hover { background: rgb(234, 242, 253); border-color: transparent; }

.map-pill { display: none; margin-left: auto; background: var(--at-ink); color: rgb(255, 255, 255); border-color: var(--at-ink); }

.browse .task-layout { display: grid; grid-template-columns: minmax(380px, 460px) 1fr; gap: 0px; height: calc(100vh - var(--head-h) - 65px); min-height: 520px; margin: 0px; }

.task-list-pane { overflow-y: auto; padding: 12px 14px 40px; background: var(--at-bg); }

.list-count { font: 600 13px "DM Sans"; color: var(--at-muted); padding: 4px 4px 10px; }

.browse .task-grid { display: flex; flex-direction: column; gap: 10px; grid-template-columns: none; }

.browse .task-card { background: rgb(255, 255, 255); border: 1.5px solid transparent; border-radius: 12px; padding: 16px 18px; box-shadow: rgba(15, 27, 77, 0.08) 0px 1px 3px; cursor: pointer; transition: border-color 0.12s, box-shadow 0.12s; display: block; min-height: 0px; }

.browse .task-card:hover, .browse .task-card.selected { border-color: var(--at-blue); box-shadow: rgba(31, 111, 229, 0.133) 0px 4px 14px; transform: none; }

.tc-head { display: flex; justify-content: space-between; gap: 14px; align-items: flex-start; }

.browse .task-card h4 { font: 500 17px / 1.35 "DM Sans"; color: var(--at-ink); margin: 0px; letter-spacing: 0px; display: block; -webkit-line-clamp: unset; }

.tc-price { font: 700 18px "DM Sans"; color: var(--at-ink); white-space: nowrap; }

.tc-body { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 10px; }

.tc-meta { list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--at-muted); }

.tc-meta li { display: flex; gap: 10px; align-items: center; }

.tc-meta i { font-style: normal; width: 16px; text-align: center; color: rgb(138, 147, 171); }

.tc-avatar { width: 44px; height: 44px; border-radius: 50%; background: rgb(232, 235, 245); display: grid; place-items: center; flex: 0 0 auto; }

.tc-avatar svg { fill: rgb(185, 192, 216); }

.tc-foot { display: flex; gap: 8px; align-items: center; margin-top: 12px; font-size: 13px; color: var(--at-muted); }

.tc-open { color: var(--at-blue); font-weight: 700; font-size: 14px; }

.empty-list { padding: 30px 10px; text-align: center; color: var(--at-muted); }

.browse .map-aside { display: block; position: relative; padding: 0px; border: 0px; background: rgb(223, 230, 242); border-radius: 0px; box-shadow: none; }

.browse .map-aside .browse-map { height: 100%; min-height: 0px; border: 0px; border-radius: 0px; }

.locate-btn { position: absolute; left: 14px; bottom: 24px; z-index: 500; border: 0px; background: rgb(255, 255, 255); border-radius: 999px; padding: 11px 18px; font: 700 13px "DM Sans"; color: var(--at-ink); box-shadow: rgba(15, 27, 77, 0.2) 0px 2px 10px; cursor: pointer; }

.price-pin-wrap { background: none !important; border: 0px !important; }

.price-pin { position: relative; transform: translate(-50%, -100%); margin-top: -6px; background: var(--at-ink); color: rgb(255, 255, 255); font: 700 13px "DM Sans"; padding: 6px 11px; border-radius: 999px; white-space: nowrap; box-shadow: rgba(15, 27, 77, 0.333) 0px 2px 8px; border: 2px solid rgb(255, 255, 255); }

.price-pin::after { content: ""; position: absolute; left: 50%; bottom: -7px; margin-left: -5px; border-width: 5px 5px 0px; border-style: solid solid none; border-right-color: transparent; border-left-color: transparent; border-image: none; border-top-color: var(--at-ink); border-bottom-color: currentcolor; }

.price-pin.active { background: var(--at-blue); transform: translate(-50%, -100%) scale(1.12); }

.price-pin.active::after { border-top-color: var(--at-blue); }

.price-pin-wrap { width: 0px !important; height: 0px !important; }

@media (max-width: 900px) {
  .topbar nav { display: none; }
  .topbar nav.open { display: flex; position: absolute; top: var(--head-h); left: 0px; right: 0px; flex-direction: column; background: rgb(255, 255, 255); padding: 12px; border-bottom: 1px solid var(--at-line); box-shadow: rgba(15, 27, 77, 0.1) 0px 10px 20px; }
  .menu-btn { display: block; font-size: 22px; }
  .topbar { gap: 12px; }
  .top-actions { margin-left: auto; }
  .hero { grid-template-columns: 1fr; padding: 36px 6%; }
  .hero-art { display: none; }
  .map-pill { display: inline-flex; }
  .browse .task-layout { display: block; height: auto; min-height: 0px; }
  .task-list-pane { overflow: visible; padding: 10px 12px 30px; }
  .browse .map-aside { display: none; }
  .browse .task-layout.map-mode .task-list-pane { display: none; }
  .browse .task-layout.map-mode .map-aside { display: block; height: calc(100vh - var(--head-h) - 65px); min-height: 420px; }
  .brand { font-size: 18px; }
}

@media (max-width: 560px) {
  .top-actions .text-btn:not(.login) { display: none; }
  .post-pill { padding: 9px 16px; }
  .pill input { width: 110px; }
}

.tc-km { color: var(--at-blue); font-weight: 700; }

.loc-btn.on { border-color: var(--at-blue); color: var(--at-blue); background: rgb(234, 242, 253); }

.loc-btn .caret { font-size: 11px; color: var(--at-muted); }

.loc-btn #locLabel { max-width: 210px; overflow: hidden; text-overflow: ellipsis; }

.loc-panel { position: fixed; z-index: 950; width: 340px; max-width: calc(-16px + 100vw); background: rgb(255, 255, 255); border: 1px solid var(--at-line); border-radius: 14px; box-shadow: rgba(15, 27, 77, 0.2) 0px 12px 40px; padding: 16px; display: none; }

.loc-panel.show { display: block; }

.lp-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font: 700 16px "DM Sans"; }

.lp-x { border: 0px; background: none; font-size: 24px; line-height: 1; cursor: pointer; color: var(--at-muted); }

.lp-sec { margin: 14px 0px; }

.lp-label { display: block; font: 700 12px "DM Sans"; color: var(--at-muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 8px; }

.lp-sec input[type="text"], .lp-sec input:not([type]) { width: 100%; border: 1px solid var(--at-line); border-radius: 10px; padding: 11px 12px; font: 500 14px "DM Sans"; margin-bottom: 8px; outline: 0px; }

.lp-sec input:focus { border-color: var(--at-blue); }

.lp-km { display: flex; justify-content: space-between; align-items: center; }

.lp-km b { font: 700 14px "DM Sans"; margin-bottom: 8px; }

.lp-sec input[type="range"] { width: 100%; accent-color: var(--at-blue); }

.lp-note { display: block; color: var(--at-muted); font-size: 11px; line-height: 1.4; margin-top: 6px; }

.lp-actions { display: flex; justify-content: space-between; gap: 10px; margin-top: 8px; }

.lp-actions .primary.small { border-radius: 999px; padding: 11px 26px; box-shadow: none; }

.lp-actions .outline { border-radius: 999px; padding: 11px 20px; }

.seg { display: flex; gap: 6px; }

.seg button { flex: 1 1 0%; border: 1px solid var(--at-line); background: rgb(255, 255, 255); border-radius: 999px; padding: 9px 10px; font: 600 13px "DM Sans"; color: var(--at-ink); cursor: pointer; }

.seg button.on { background: var(--at-ink); border-color: var(--at-ink); color: rgb(255, 255, 255); }

.post-seg { max-width: 340px; }

.tc-avatar.initials { color: rgb(255, 255, 255); font: 700 14px "DM Sans"; }

.tc-foot .tc-cat { margin-left: auto; font-size: 11px; color: rgb(138, 147, 171); }

.empty-list .outline { margin-top: 6px; border-radius: 999px; }

.task-when { color: var(--at-muted); font-size: 13px; margin-top: -6px; }

.map-preview { display: none; position: absolute; left: 12px; right: 12px; bottom: 14px; z-index: 600; background: rgb(255, 255, 255); border-radius: 14px; box-shadow: rgba(15, 27, 77, 0.267) 0px 6px 24px; padding: 12px 14px; justify-content: space-between; align-items: center; gap: 12px; }

.map-preview.show { display: flex; }

.map-preview b { display: block; font: 600 15px "DM Sans"; }

.map-preview span { font-size: 13px; color: var(--at-muted); }

.map-preview button { border: 0px; background: var(--at-blue); color: rgb(255, 255, 255); border-radius: 999px; padding: 9px 18px; font: 700 13px "DM Sans"; cursor: pointer; }

@media (min-width: 901px) {
  .map-preview { display: none !important; }
}

@media (max-width: 560px) {
  .loc-panel { right: 8px; width: auto; left: 8px !important; }
  .map-preview.show + * { }
  .locate-btn { bottom: 90px; }
}

.hidden { display: none !important; }

section[id], main[id] { scroll-margin-top: 76px; }

body.no-scroll { overflow: hidden; }

.topbar { display: flex; align-items: center; justify-content: flex-start; gap: 12px; padding: 0px 16px; position: sticky; top: 0px; z-index: 1000; background: rgb(255, 255, 255); }

.hamburger { width: 42px; height: 42px; border: 0px; background: none; border-radius: 10px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; cursor: pointer; flex: 0 0 auto; }

