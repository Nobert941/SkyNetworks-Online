.hamburger span { display: block; width: 22px; height: 2.5px; border-radius: 2px; background: var(--at-ink); }

.topbar .brand { margin-right: auto; }

.top-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }

.post-pill { display: inline-flex; align-items: center; gap: 6px; }

