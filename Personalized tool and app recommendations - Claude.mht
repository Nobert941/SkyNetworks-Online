.auth-status { display: none; margin-top: 14px; padding: 12px; border-radius: 8px; background: rgb(237, 246, 255); color: rgb(23, 75, 124); font-size: 12px; line-height: 1.55; overflow-wrap: anywhere; }

.auth-status.visible { display: block; }

