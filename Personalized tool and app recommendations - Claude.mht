.hero-art { position: relative; padding: 20px; }

.map-card { background: rgb(255, 255, 255); border-radius: 16px; padding: 17px; box-shadow: rgba(24, 58, 101, 0.11) 0px 22px 60px; transform: rotate(1deg); }

.map-top, .map-foot { display: flex; justify-content: space-between; font-size: 9px; letter-spacing: 1.1px; font-weight: 800; color: rgb(135, 149, 168); }

.live-dot { color: rgb(38, 164, 122); }

.map-grid { height: 310px; margin: 14px 0px; background-color: rgb(233, 240, 232); background-image: linear-gradient(35deg, transparent 47%, rgb(255, 255, 255) 48%, rgb(255, 255, 255) 51%, transparent 52%), linear-gradient(110deg, transparent 46%, rgb(255, 255, 255) 47%, rgb(255, 255, 255) 50%, transparent 51%), linear-gradient(0deg, rgb(216, 231, 216) 1px, transparent 1px), linear-gradient(90deg, rgb(216, 231, 216) 1px, transparent 1px); background-size: 100% 100%, 100% 100%, 42px 42px, 42px 42px; position: relative; overflow: hidden; border-radius: 9px; }

.road { position: absolute; background: rgb(255, 255, 255); opacity: 0.9; height: 8px; width: 120%; transform: rotate(-24deg); top: 45%; left: -10%; }

.r2 { transform: rotate(54deg); top: 40%; left: -10%; height: 6px; }

.r3 { transform: rotate(8deg); top: 75%; height: 5px; }

.pin { position: absolute; width: 29px; height: 29px; border-radius: 50% 50% 50% 0px; transform: rotate(-45deg); background: var(--bright); color: rgb(255, 255, 255); display: grid; place-items: center; box-shadow: rgba(21, 60, 108, 0.333) 0px 4px 10px; }

.pin::first-letter { transform: rotate(45deg); }

.p1 { left: 23%; top: 25%; }

.p2 { left: 67%; top: 35%; background: rgb(23, 164, 122); }

.p3 { left: 44%; top: 69%; background: rgb(228, 156, 53); }

.p4 { left: 80%; top: 76%; }

.map-label { position: absolute; font-size: 9px; color: rgb(100, 119, 101); font-weight: 700; }

.l1 { top: 17%; left: 15%; }

.l2 { top: 61%; left: 69%; }

.l3 { top: 83%; left: 31%; }

.map-center { position: absolute; left: 43%; top: 39%; border-radius: 50%; width: 74px; height: 74px; background: rgb(255, 255, 255); color: var(--navy); display: grid; place-content: center; text-align: center; font: 800 10px Manrope; letter-spacing: 1px; box-shadow: rgba(40, 77, 48, 0.125) 0px 3px 15px; }

.map-foot { letter-spacing: 0px; font-size: 10px; }

.float-card { position: absolute; bottom: 0px; left: -5px; background: rgb(255, 255, 255); padding: 13px 18px; border-radius: 11px; box-shadow: rgba(24, 58, 101, 0.125) 0px 12px 35px; display: flex; gap: 11px; align-items: center; }

.float-icon { width: 30px; height: 30px; border-radius: 9px; background: rgb(229, 247, 240); color: rgb(25, 152, 110); display: grid; place-items: center; font-weight: 800; }

.float-card b, .float-card small { display: block; }

.float-card b { font-size: 11px; }

.float-card small { font-size: 9px; color: rgb(124, 137, 153); margin-top: 3px; }

.search-wrap { padding: 80px 8.5%; }

.search-heading, .section-title { display: flex; justify-content: space-between; align-items: end; }

.search-heading h2, .how h2, .trust h2, .terms h2 { font: 800 32px Manrope; color: var(--navy); margin: 10px 0px 25px; letter-spacing: -1px; }

.outline { background: rgb(255, 255, 255); border: 1px solid rgb(203, 215, 229); border-radius: 7px; padding: 11px 15px; color: var(--navy); font-weight: 700; font-size: 12px; cursor: pointer; }

.searchbar { display: flex; align-items: center; gap: 12px; padding: 10px; border: 1px solid rgb(220, 228, 238); border-radius: 10px; box-shadow: rgba(27, 60, 100, 0.063) 0px 8px 24px; }

.searchbar > span { font-size: 25px; color: rgb(127, 145, 169); padding-left: 8px; }

.searchbar input { flex: 1 1 0%; border: 0px; outline: 0px; font: 14px "DM Sans"; min-width: 80px; }

.searchbar select { border-top: 0px; border-right: 0px; border-bottom: 0px; border-image: none; border-left: 1px solid var(--line); padding: 10px; color: rgb(101, 117, 139); background: rgb(255, 255, 255); outline: 0px; }

.category-row { display: flex; gap: 10px; margin: 24px 0px 38px; flex-wrap: wrap; }

.cat { border: 1px solid var(--line); border-radius: 30px; background: rgb(255, 255, 255); padding: 10px 15px; font-size: 11px; color: rgb(96, 112, 135); cursor: pointer; }

.cat.active, .cat:hover { background: var(--pale); border-color: rgb(200, 218, 242); color: var(--blue); }

.section-title { align-items: center; margin-bottom: 17px; }

