.avatars { display: flex; padding-left: 5px; }

.avatars b { width: 32px; height: 32px; border: 2px solid rgb(244, 248, 253); background: rgb(198, 216, 239); border-radius: 50%; display: grid; place-items: center; font-size: 9px; color: rgb(23, 62, 112); margin-left: -5px; }

