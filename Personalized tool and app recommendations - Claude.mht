.task-layout { display: grid; grid-template-columns: 1fr 270px; gap: 24px; }

.task-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }

.task-card { border: 1px solid var(--line); border-radius: 11px; padding: 18px; transition: 0.2s; background: rgb(255, 255, 255); }

.task-card:hover { box-shadow: rgba(25, 57, 94, 0.07) 0px 12px 30px; transform: translateY(-2px); }

.task-meta { display: flex; justify-content: space-between; font-size: 9px; color: rgb(135, 148, 165); }

.task-category { background: rgb(238, 244, 252); color: rgb(40, 100, 168); padding: 5px 8px; border-radius: 20px; font-weight: 700; }

.task-card h4 { font: 700 15px Manrope; color: var(--navy); margin: 15px 0px 7px; }

.task-card p { font-size: 11px; line-height: 1.55; color: rgb(119, 134, 154); min-height: 36px; }

.task-bottom { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgb(237, 240, 244); padding-top: 13px; margin-top: 14px; }

.task-price { font-weight: 800; color: var(--navy); font-size: 14px; }

.task-place { font-size: 10px; color: rgb(132, 145, 162); }

.task-bottom button { border: 0px; background: none; color: var(--bright); font-size: 11px; font-weight: 800; cursor: pointer; }

.map-aside { border: 1px solid var(--line); border-radius: 11px; padding: 14px; height: max-content; }

.aside-head { display: flex; justify-content: space-between; font-size: 11px; }

.aside-head span { color: rgb(145, 160, 177); font-size: 9px; }

.mini-map { height: 175px; background: linear-gradient(45deg, transparent 48%, white 49%, white 52%, transparent 53%) 0% 0% / 100% 100%, linear-gradient(110deg, transparent 47%, white 48%, white 51%, transparent 52%) 0% 0% / 100% 100%, linear-gradient(rgb(212, 228, 210) 1px, transparent 1px) 0% 0% / 25px 25px, linear-gradient(90deg, rgb(212, 228, 210) 1px, transparent 1px) 0% 0% / 25px 25px rgb(232, 240, 230); margin: 13px 0px; border-radius: 8px; position: relative; overflow: hidden; }

.mini-map::after { content: ""; position: absolute; width: 70px; height: 70px; border: 1px solid rgba(126, 181, 216, 0.4); border-radius: 50%; left: 40%; top: 29%; background: rgba(126, 181, 216, 0.133); }

.mini-map label { position: absolute; left: 38%; top: 49%; font-size: 9px; font-weight: 800; color: rgb(101, 122, 104); letter-spacing: 2px; }

.mini-road { position: absolute; background: white; height: 5px; width: 120%; top: 35%; transform: rotate(30deg); }

.mini-road.b { top: 67%; transform: rotate(-35deg); }

.mini-road.c { top: 15%; transform: rotate(90deg); width: 90%; }

.mpin { position: absolute; z-index: 1; color: rgb(40, 116, 206); font-size: 18px; }

.m1 { left: 20%; top: 20%; }

.m2 { left: 72%; top: 28%; color: rgb(226, 154, 50); }

.m3 { left: 53%; top: 74%; }

.m4 { left: 83%; top: 77%; color: rgb(32, 161, 123); }

.map-aside p { font-size: 10px; line-height: 1.6; color: rgb(130, 144, 162); }

.full { width: 100%; }

.how { background: rgb(246, 248, 251); padding: 78px 8.5%; text-align: center; }

.how h2 { margin-bottom: 42px; }

.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 17px; text-align: left; }

.steps article { background: rgb(255, 255, 255); border: 1px solid rgb(233, 238, 244); border-radius: 11px; padding: 22px; position: relative; }

.steps article > span { position: absolute; right: 18px; top: 18px; color: rgb(185, 199, 215); font-size: 11px; font-weight: 800; }

.step-icon { width: 42px; height: 42px; border-radius: 12px; background: rgb(234, 242, 252); display: grid; place-items: center; font-size: 19px; }

.steps h3 { font: 700 14px Manrope; color: var(--navy); margin: 20px 0px 9px; }

.steps p { font-size: 11px; line-height: 1.7; color: rgb(122, 137, 155); margin: 0px; }

.trust { padding: 85px 10%; display: grid; grid-template-columns: 1fr 1fr; gap: 12%; align-items: center; }

.trust h2 { font-size: 38px; line-height: 1.2; }

.trust > div > p { font-size: 13px; line-height: 1.8; color: rgb(113, 129, 151); max-width: 450px; }

.underlink { display: inline-block; color: var(--bright); font-size: 12px; font-weight: 800; margin-top: 10px; }

.trust-cards { display: grid; gap: 12px; }

.trust-cards article { padding: 19px 20px; border: 1px solid var(--line); border-radius: 10px; }

.trust-cards b { font: 700 13px Manrope; color: var(--navy); }

.trust-cards p { font-size: 11px; line-height: 1.6; color: rgb(122, 137, 155); margin: 8px 0px 0px; }

.cta { margin: 0px 8.5% 75px; padding: 34px 42px; border-radius: 14px; background: var(--navy); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: space-between; }

.cta .eyebrow { color: rgb(142, 190, 255); }

.cta h2 { font: 800 24px Manrope; margin: 10px 0px; }

.cta p { color: rgb(182, 196, 216); font-size: 12px; margin: 0px; }

.cta .primary { background: rgb(255, 255, 255); color: var(--navy); box-shadow: none; }

.terms { padding: 65px 9%; background: rgb(247, 249, 252); }

.terms h2 { margin-bottom: 8px; }

.muted { font-size: 12px; line-height: 1.6; color: rgb(120, 135, 154); max-width: 700px; }

.terms-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 25px; }

.terms-grid article { background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 9px; padding: 17px; }

.terms-grid h3 { font: 700 12px Manrope; color: var(--navy); }

.terms-grid p, .terms-note { font-size: 10px; line-height: 1.7; color: rgb(122, 137, 155); }

.terms-note { margin-top: 18px; }

footer { padding: 30px 7%; display: flex; align-items: center; justify-content: space-between; gap: 20px; }

footer > span { font-size: 10px; color: rgb(138, 152, 169); }

footer > div { display: flex; gap: 18px; font-size: 11px; font-weight: 700; color: rgb(101, 117, 138); }

.modal-backdrop { display: none; position: fixed; inset: 0px; background: rgba(6, 23, 45, 0.8); z-index: 30; align-items: center; justify-content: center; padding: 20px; }

.modal-backdrop.show { display: flex; }

.modal { background: rgb(255, 255, 255); border-radius: 15px; width: min(570px, 100%); max-height: 90vh; overflow: auto; padding: 30px; position: relative; box-shadow: rgba(0, 0, 0, 0.267) 0px 25px 90px; }

.close { position: absolute; right: 18px; top: 12px; border: 0px; background: none; font-size: 27px; color: rgb(130, 144, 162); cursor: pointer; }

.modal h2 { font: 800 23px Manrope; color: var(--navy); margin: 0px 30px 8px 0px; }

.modal p { font-size: 12px; line-height: 1.6; color: rgb(119, 134, 154); }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

.field { display: grid; gap: 6px; margin: 12px 0px; }

.field.full-field { grid-column: 1 / -1; }

.field label { font-size: 10px; font-weight: 800; color: rgb(82, 100, 124); }

.field input, .field select, .field textarea { border: 1px solid rgb(220, 228, 238); border-radius: 7px; padding: 12px; font: 12px "DM Sans"; outline-color: rgb(139, 183, 237); width: 100%; }

.field textarea { min-height: 80px; resize: vertical; }

.fee-box { background: rgb(241, 246, 252); padding: 12px; border-radius: 8px; font-size: 11px; color: rgb(83, 103, 127); line-height: 1.6; margin: 12px 0px; }

.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }

.toast { position: fixed; bottom: 25px; right: 25px; background: var(--navy); color: rgb(255, 255, 255); padding: 13px 18px; border-radius: 8px; font-size: 12px; opacity: 0; transform: translateY(10px); transition: 0.25s; z-index: 50; pointer-events: none; }

.toast.show { opacity: 1; transform: translateY(0px); }

.chat-box { border: 1px solid var(--line); border-radius: 9px; overflow: hidden; margin-top: 15px; }

.chat-head { padding: 12px; background: rgb(244, 247, 251); font-size: 11px; font-weight: 800; display: flex; justify-content: space-between; }

.chat-messages { height: 180px; overflow: auto; padding: 12px; background: rgb(255, 255, 255); }

.bubble { max-width: 85%; background: rgb(238, 244, 252); border-radius: 10px; padding: 9px 11px; font-size: 11px; margin: 7px 0px; color: rgb(52, 75, 104); }

.bubble.mine { margin-left: auto; background: rgb(223, 243, 234); }

.chat-compose { display: flex; padding: 8px; border-top: 1px solid var(--line); gap: 7px; }

.chat-compose input { flex: 1 1 0%; border: 1px solid var(--line); border-radius: 6px; padding: 9px; font-size: 11px; }

.chat-compose button { border: 0px; background: var(--bright); color: white; border-radius: 6px; padding: 0px 14px; }

.notice { background: rgb(255, 247, 232); color: rgb(136, 99, 34); border-radius: 7px; padding: 10px; font-size: 10px; line-height: 1.5; margin: 12px 0px; }

@media (max-width: 900px) {
  .topbar { padding: 0px 4%; }
  .topbar nav { gap: 14px; }
  .hero { padding: 65px 6%; gap: 2%; }
  .search-wrap, .how { padding: 65px 6%; }
  .trust { padding: 65px 7%; gap: 6%; }
  .steps { grid-template-columns: repeat(2, 1fr); }
  .task-layout { grid-template-columns: 1fr 220px; }
}

@media (max-width: 680px) {
  .topbar { height: 70px; }
  .topbar nav { display: none; position: absolute; top: 70px; left: 0px; right: 0px; background: rgb(255, 255, 255); padding: 20px; flex-direction: column; border-bottom: 1px solid var(--line); }
  .topbar nav.open { display: flex; }
  .top-actions { gap: 10px; }
  .top-actions .text-btn { display: none; }
  .menu-btn { display: block; }
  .brand { font-size: 17px; }
  .brand-mark { width: 34px; height: 34px; }
  .hero { grid-template-columns: 1fr; padding: 55px 7%; }
  .hero-art { margin-top: 20px; }
  .map-grid { height: 230px; }
  .hero h1 { font-size: 48px; }
  .search-heading { align-items: start; gap: 10px; }
  .search-heading h2 { font-size: 25px; }
  .searchbar { flex-wrap: wrap; }
  .searchbar input { min-width: 65%; padding: 8px; }
  .searchbar select { flex: 1 1 0%; border: 1px solid var(--line); }
  .searchbar .primary { flex: 1 1 0%; }
  .task-layout { grid-template-columns: 1fr; }
  .task-grid { grid-template-columns: 1fr; }
  .map-aside { display: none; }
  .steps { grid-template-columns: 1fr 1fr; }
  .trust { grid-template-columns: 1fr; gap: 30px; }
  .trust h2 { font-size: 32px; }
  .terms-grid { grid-template-columns: 1fr 1fr; }
  .cta { margin: 0px 5% 50px; padding: 25px; gap: 15px; align-items: flex-start; flex-direction: column; }
  .cta h2 { font-size: 21px; }
  footer { flex-wrap: wrap; padding: 25px 6%; }
  footer > span { order: 3; width: 100%; }
}

@media (max-width: 420px) {
  .steps, .terms-grid { grid-template-columns: 1fr; }
  .hero h1 { font-size: 43px; }
  .float-card { left: 0px; }
  .search-heading .outline { font-size: 10px; padding: 9px; }
  .form-grid { grid-template-columns: 1fr; }
  .field.full-field { grid-column: auto; }
}

.leaflet-map { width: 100%; height: 100%; min-height: 190px; border-radius: 9px; z-index: 1; }

.hero-map { height: 255px; min-height: 255px; border-radius: 0px; }

.browse-map { height: 230px; min-height: 230px; margin: 13px 0px; }

.map-card { overflow: hidden; }

.map-card .map-grid { display: none; }

.conversation-intro { padding: 64px 9%; display: grid; grid-template-columns: 1fr 1fr; gap: 9%; align-items: center; background: rgb(245, 248, 252); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

.conversation-intro h2 { font: 800 30px Manrope; color: var(--navy); margin: 10px 0px; }

.conversation-intro p { font-size: 13px; line-height: 1.8; color: rgb(113, 129, 151); }

.conversation-rules { display: grid; gap: 12px; }

