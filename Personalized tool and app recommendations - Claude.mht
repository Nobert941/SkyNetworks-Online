.offer-form h3 { font: 700 14px Manrope; color: var(--navy); }

.checkline { font-size: 11px; color: rgb(83, 100, 123); }

.notification-dock { position: fixed; right: 18px; bottom: 18px; z-index: 25; }

.notification-button { border: 0px; border-radius: 25px; padding: 11px 15px; background: var(--navy); color: white; font-weight: 700; box-shadow: rgba(7, 29, 60, 0.2) 0px 8px 25px; }

