@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap");

:root { --navy: #071d3c; --blue: #123e78; --bright: #2d75d7; --pale: #eaf2fc; --ink: #13233b; --muted: #6c7b90; --line: #e4eaf1; --white: #fff; --gold: #f3b84b; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; color: var(--ink); font-family: "DM Sans", sans-serif; background: rgb(255, 255, 255); }

a { color: inherit; text-decoration: none; }

.topbar { height: 82px; padding: 0px 6.5%; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); background: rgb(255, 255, 255); position: sticky; top: 0px; z-index: 10; }

.brand { display: flex; gap: 10px; align-items: center; font-family: Manrope; font-weight: 800; font-size: 20px; color: var(--navy); line-height: 1; }

.brand-mark { width: 38px; height: 38px; border-radius: 12px; background: var(--navy); color: rgb(255, 255, 255); display: grid; place-items: center; font-size: 22px; }

.brand-light { font-weight: 500; color: var(--bright); }

.brand small { display: block; font: 700 8px "DM Sans"; letter-spacing: 1.45px; color: rgb(130, 144, 162); margin-top: 5px; }

.topbar nav { display: flex; gap: 30px; font-size: 13px; font-weight: 600; color: rgb(83, 100, 123); }

.topbar nav a:hover, footer a:hover { color: var(--bright); }

.top-actions { display: flex; gap: 18px; align-items: center; }

.text-btn, .menu-btn { border: 0px; background: none; color: var(--navy); font-weight: 700; cursor: pointer; }

.menu-btn { display: none; }

.primary { border: 0px; background: var(--bright); color: rgb(255, 255, 255); border-radius: 8px; padding: 15px 23px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: rgba(45, 117, 215, 0.16) 0px 7px 18px; }

.primary:hover { background: rgb(30, 97, 184); transform: translateY(-1px); }

.primary span { margin-left: 16px; }

.primary.small { padding: 11px 18px; font-size: 13px; }

.hero { background: linear-gradient(112deg, rgb(245, 248, 253) 0%, rgb(241, 246, 253) 55%, rgb(229, 239, 252) 100%); padding: 85px 9% 80px; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 5%; }

