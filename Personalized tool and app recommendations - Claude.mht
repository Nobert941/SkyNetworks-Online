.conversation-rules span { font-size: 11px; line-height: 1.6; color: rgb(113, 129, 151); margin-top: 6px; }

.chat-section, .offers-section, .offer-form { border: 1px solid var(--line); border-radius: 10px; padding: 13px; margin-top: 15px; }

.chat-title { display: flex; justify-content: space-between; gap: 12px; align-items: center; font-size: 12px; color: var(--navy); }

.chat-title span { font-size: 10px; color: rgb(129, 144, 163); text-align: right; }

.privacy-hint { background: rgb(241, 246, 252); padding: 9px 11px; border-radius: 7px; font-size: 10px !important; color: rgb(83, 107, 134) !important; }

.chat-messages { height: 210px; overflow: auto; padding: 10px; background: rgb(251, 252, 254); border: 1px solid rgb(237, 241, 246); border-radius: 8px; }

.bubble { max-width: 86%; background: rgb(234, 242, 252); border-radius: 10px 10px 10px 3px; padding: 9px 11px; font-size: 11px; margin: 8px 0px; color: rgb(52, 75, 104); overflow-wrap: anywhere; }

.bubble.mine { margin-left: auto; background: rgb(223, 243, 234); border-radius: 10px 10px 3px; }

.bubble small { display: block; color: rgb(113, 129, 151); font-size: 9px; margin-bottom: 5px; }

.chat-compose { display: flex; gap: 8px; margin-top: 9px; }

