@keyframes sheet-card-draw-x { 
  0% { transform: scaleX(0); }
}

@keyframes sheet-card-draw-y { 
  0% { transform: scaleY(0); }
}

@keyframes sheet-card-dash { 
  0% { stroke-dashoffset: 1px; }
}

@keyframes sheet-card-pop { 
  0% { transform: scale(0); }
}

@keyframes sheet-card-stamp { 
  0% { opacity: 0; }
  2% { opacity: 1; }
  100% { opacity: 0.72; }
}

@keyframes sheet-card-reveal-x { 
  0% { clip-path: inset(0px 100% 0px 0px); }
  100% { clip-path: inset(0px); }
}

@keyframes sheet-card-ride { 
  0% { translate: 0px; }
}

@keyframes sheet-card-blink { 
  0%, 50%, 100% { opacity: 1; }
  25%, 75% { opacity: 0; }
}

@keyframes sheet-card-sweep { 
  0% { --sheet-card-sweep: 0deg; }
}

@keyframes sheet-card-tighten { 
  0% { translate: var(--sheet-card-tx,0px) var(--sheet-card-ty,0px); opacity: 0; }
}

@keyframes sheet-card-appear { 
  0% { opacity: 0; }
}

