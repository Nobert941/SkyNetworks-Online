@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap");

:root { --navy: #071d3c; --blue: #123e78; --bright: #2d75d7; --pale: #eaf2fc; --ink: #13233b; --muted: #6c7b90; --line: #e4eaf1; --white: #fff; --gold: #f3b84b; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; color: var(--ink); font-family: "DM Sans", sans-serif; background: rgb(255, 255, 255); }

a { color: inherit; text-decoration: none; }

.topbar { height: 82px; padding: 0px 6.5%; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); background: rgb(255, 255, 255); position: sticky; top: 0px; z-index: 10; }

.brand { display: flex; gap: 10px; align-items: center; font-family: Manrope; font-weight: 800; font-size: 20px; color: var(--navy); line-height: 1; }

.brand-mark { width: 38px; height: 38px; border-radius: 12px; background: var(--navy); color: rgb(255, 255, 255); display: grid; place-items: center; font-size: 22px; }

.brand-light { font-weight: 500; color: var(--bright); }

.brand small { display: block; font: 700 8px "DM Sans"; letter-spacing: 1.45px; color: rgb(130, 144, 162); margin-top: 5px; }

.topbar nav { display: flex; gap: 30px; font-size: 13px; font-weight: 600; color: rgb(83, 100, 123); }

.topbar nav a:hover, footer a:hover { color: var(--bright); }

.top-actions { display: flex; gap: 18px; align-items: center; }

.text-btn, .menu-btn { border: 0px; background: none; color: var(--navy); font-weight: 700; cursor: pointer; }

.menu-btn { display: none; }

.primary { border: 0px; background: var(--bright); color: rgb(255, 255, 255); border-radius: 8px; padding: 15px 23px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: rgba(45, 117, 215, 0.16) 0px 7px 18px; }

.primary:hover { background: rgb(30, 97, 184); transform: translateY(-1px); }

.primary span { margin-left: 16px; }

.primary.small { padding: 11px 18px; font-size: 13px; }

.hero { background: linear-gradient(112deg, rgb(245, 248, 253) 0%, rgb(241, 246, 253) 55%, rgb(229, 239, 252) 100%); padding: 85px 9% 80px; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 5%; }

.eyebrow { font-size: 10px; letter-spacing: 1.8px; color: var(--bright); font-weight: 800; }

.eyebrow span { display: inline-block; width: 7px; height: 7px; background: rgb(50, 181, 138); border-radius: 50%; margin-right: 7px; }

.hero h1 { font: 800 clamp(42px, 5vw, 66px) / 1.1 Manrope; color: var(--navy); letter-spacing: -2.5px; margin: 22px 0px; }

.hero h1 em, .trust h2 em { color: var(--bright); font-style: normal; }

.hero-copy > p { font-size: 17px; line-height: 1.7; color: rgb(99, 115, 138); max-width: 470px; }

.hero-buttons { display: flex; align-items: center; gap: 26px; margin: 28px 0px 42px; }

.secondary { font-size: 14px; font-weight: 700; border-bottom: 1px solid rgb(156, 174, 195); padding-bottom: 5px; }

.proof { display: flex; align-items: center; gap: 15px; font-size: 11px; color: rgb(120, 134, 154); line-height: 1.5; }

.proof strong { color: rgb(38, 60, 89); }

.avatars { display: flex; padding-left: 5px; }

.avatars b { width: 32px; height: 32px; border: 2px solid rgb(244, 248, 253); background: rgb(198, 216, 239); border-radius: 50%; display: grid; place-items: center; font-size: 9px; color: rgb(23, 62, 112); margin-left: -5px; }

.avatars b:nth-child(2) { background: rgb(217, 200, 182); }

.avatars b:nth-child(3) { background: rgb(185, 217, 208); }

.hero-art { position: relative; padding: 20px; }

.map-card { background: rgb(255, 255, 255); border-radius: 16px; padding: 17px; box-shadow: rgba(24, 58, 101, 0.11) 0px 22px 60px; transform: rotate(1deg); }

.map-top, .map-foot { display: flex; justify-content: space-between; font-size: 9px; letter-spacing: 1.1px; font-weight: 800; color: rgb(135, 149, 168); }

.live-dot { color: rgb(38, 164, 122); }

.map-grid { height: 310px; margin: 14px 0px; background-color: rgb(233, 240, 232); background-image: linear-gradient(35deg, transparent 47%, rgb(255, 255, 255) 48%, rgb(255, 255, 255) 51%, transparent 52%), linear-gradient(110deg, transparent 46%, rgb(255, 255, 255) 47%, rgb(255, 255, 255) 50%, transparent 51%), linear-gradient(0deg, rgb(216, 231, 216) 1px, transparent 1px), linear-gradient(90deg, rgb(216, 231, 216) 1px, transparent 1px); background-size: 100% 100%, 100% 100%, 42px 42px, 42px 42px; position: relative; overflow: hidden; border-radius: 9px; }

.road { position: absolute; background: rgb(255, 255, 255); opacity: 0.9; height: 8px; width: 120%; transform: rotate(-24deg); top: 45%; left: -10%; }

.r2 { transform: rotate(54deg); top: 40%; left: -10%; height: 6px; }

.r3 { transform: rotate(8deg); top: 75%; height: 5px; }

.pin { position: absolute; width: 29px; height: 29px; border-radius: 50% 50% 50% 0px; transform: rotate(-45deg); background: var(--bright); color: rgb(255, 255, 255); display: grid; place-items: center; box-shadow: rgba(21, 60, 108, 0.333) 0px 4px 10px; }

.pin::first-letter { transform: rotate(45deg); }

.p1 { left: 23%; top: 25%; }

.p2 { left: 67%; top: 35%; background: rgb(23, 164, 122); }

.p3 { left: 44%; top: 69%; background: rgb(228, 156, 53); }

.p4 { left: 80%; top: 76%; }

.map-label { position: absolute; font-size: 9px; color: rgb(100, 119, 101); font-weight: 700; }

.l1 { top: 17%; left: 15%; }

.l2 { top: 61%; left: 69%; }

.l3 { top: 83%; left: 31%; }

.map-center { position: absolute; left: 43%; top: 39%; border-radius: 50%; width: 74px; height: 74px; background: rgb(255, 255, 255); color: var(--navy); display: grid; place-content: center; text-align: center; font: 800 10px Manrope; letter-spacing: 1px; box-shadow: rgba(40, 77, 48, 0.125) 0px 3px 15px; }

.map-foot { letter-spacing: 0px; font-size: 10px; }

.float-card { position: absolute; bottom: 0px; left: -5px; background: rgb(255, 255, 255); padding: 13px 18px; border-radius: 11px; box-shadow: rgba(24, 58, 101, 0.125) 0px 12px 35px; display: flex; gap: 11px; align-items: center; }

.float-icon { width: 30px; height: 30px; border-radius: 9px; background: rgb(229, 247, 240); color: rgb(25, 152, 110); display: grid; place-items: center; font-weight: 800; }

.float-card b, .float-card small { display: block; }

.float-card b { font-size: 11px; }

.float-card small { font-size: 9px; color: rgb(124, 137, 153); margin-top: 3px; }

.search-wrap { padding: 80px 8.5%; }

.search-heading, .section-title { display: flex; justify-content: space-between; align-items: end; }

.search-heading h2, .how h2, .trust h2, .terms h2 { font: 800 32px Manrope; color: var(--navy); margin: 10px 0px 25px; letter-spacing: -1px; }

.outline { background: rgb(255, 255, 255); border: 1px solid rgb(203, 215, 229); border-radius: 7px; padding: 11px 15px; color: var(--navy); font-weight: 700; font-size: 12px; cursor: pointer; }

.searchbar { display: flex; align-items: center; gap: 12px; padding: 10px; border: 1px solid rgb(220, 228, 238); border-radius: 10px; box-shadow: rgba(27, 60, 100, 0.063) 0px 8px 24px; }

.searchbar > span { font-size: 25px; color: rgb(127, 145, 169); padding-left: 8px; }

.searchbar input { flex: 1 1 0%; border: 0px; outline: 0px; font: 14px "DM Sans"; min-width: 80px; }

.searchbar select { border-top: 0px; border-right: 0px; border-bottom: 0px; border-image: none; border-left: 1px solid var(--line); padding: 10px; color: rgb(101, 117, 139); background: rgb(255, 255, 255); outline: 0px; }

.category-row { display: flex; gap: 10px; margin: 24px 0px 38px; flex-wrap: wrap; }

.cat { border: 1px solid var(--line); border-radius: 30px; background: rgb(255, 255, 255); padding: 10px 15px; font-size: 11px; color: rgb(96, 112, 135); cursor: pointer; }

.cat.active, .cat:hover { background: var(--pale); border-color: rgb(200, 218, 242); color: var(--blue); }

.section-title { align-items: center; margin-bottom: 17px; }

.section-title h3 { font: 700 18px Manrope; margin: 0px; color: var(--navy); }

.section-title span { font-size: 11px; color: rgb(130, 144, 162); }

.task-layout { display: grid; grid-template-columns: 1fr 270px; gap: 24px; }

.task-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }

.task-card { border: 1px solid var(--line); border-radius: 11px; padding: 18px; transition: 0.2s; background: rgb(255, 255, 255); }

.task-card:hover { box-shadow: rgba(25, 57, 94, 0.07) 0px 12px 30px; transform: translateY(-2px); }

.task-meta { display: flex; justify-content: space-between; font-size: 9px; color: rgb(135, 148, 165); }

.task-category { background: rgb(238, 244, 252); color: rgb(40, 100, 168); padding: 5px 8px; border-radius: 20px; font-weight: 700; }

.task-card h4 { font: 700 15px Manrope; color: var(--navy); margin: 15px 0px 7px; }

.task-card p { font-size: 11px; line-height: 1.55; color: rgb(119, 134, 154); min-height: 36px; }

.task-bottom { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgb(237, 240, 244); padding-top: 13px; margin-top: 14px; }

.task-price { font-weight: 800; color: var(--navy); font-size: 14px; }

.task-place { font-size: 10px; color: rgb(132, 145, 162); }

.task-bottom button { border: 0px; background: none; color: var(--bright); font-size: 11px; font-weight: 800; cursor: pointer; }

.map-aside { border: 1px solid var(--line); border-radius: 11px; padding: 14px; height: max-content; }

.aside-head { display: flex; justify-content: space-between; font-size: 11px; }

.aside-head span { color: rgb(145, 160, 177); font-size: 9px; }

.mini-map { height: 175px; background: linear-gradient(45deg, transparent 48%, white 49%, white 52%, transparent 53%) 0% 0% / 100% 100%, linear-gradient(110deg, transparent 47%, white 48%, white 51%, transparent 52%) 0% 0% / 100% 100%, linear-gradient(rgb(212, 228, 210) 1px, transparent 1px) 0% 0% / 25px 25px, linear-gradient(90deg, rgb(212, 228, 210) 1px, transparent 1px) 0% 0% / 25px 25px rgb(232, 240, 230); margin: 13px 0px; border-radius: 8px; position: relative; overflow: hidden; }

.mini-map::after { content: ""; position: absolute; width: 70px; height: 70px; border: 1px solid rgba(126, 181, 216, 0.4); border-radius: 50%; left: 40%; top: 29%; background: rgba(126, 181, 216, 0.133); }

.mini-map label { position: absolute; left: 38%; top: 49%; font-size: 9px; font-weight: 800; color: rgb(101, 122, 104); letter-spacing: 2px; }

.mini-road { position: absolute; background: white; height: 5px; width: 120%; top: 35%; transform: rotate(30deg); }

.mini-road.b { top: 67%; transform: rotate(-35deg); }

.mini-road.c { top: 15%; transform: rotate(90deg); width: 90%; }

.mpin { position: absolute; z-index: 1; color: rgb(40, 116, 206); font-size: 18px; }

.m1 { left: 20%; top: 20%; }

.m2 { left: 72%; top: 28%; color: rgb(226, 154, 50); }

.m3 { left: 53%; top: 74%; }

.m4 { left: 83%; top: 77%; color: rgb(32, 161, 123); }

.map-aside p { font-size: 10px; line-height: 1.6; color: rgb(130, 144, 162); }

.full { width: 100%; }

.how { background: rgb(246, 248, 251); padding: 78px 8.5%; text-align: center; }

.how h2 { margin-bottom: 42px; }

.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 17px; text-align: left; }

.steps article { background: rgb(255, 255, 255); border: 1px solid rgb(233, 238, 244); border-radius: 11px; padding: 22px; position: relative; }

.steps article > span { position: absolute; right: 18px; top: 18px; color: rgb(185, 199, 215); font-size: 11px; font-weight: 800; }

.step-icon { width: 42px; height: 42px; border-radius: 12px; background: rgb(234, 242, 252); display: grid; place-items: center; font-size: 19px; }

.steps h3 { font: 700 14px Manrope; color: var(--navy); margin: 20px 0px 9px; }

.steps p { font-size: 11px; line-height: 1.7; color: rgb(122, 137, 155); margin: 0px; }

.trust { padding: 85px 10%; display: grid; grid-template-columns: 1fr 1fr; gap: 12%; align-items: center; }

.trust h2 { font-size: 38px; line-height: 1.2; }

.trust > div > p { font-size: 13px; line-height: 1.8; color: rgb(113, 129, 151); max-width: 450px; }

.underlink { display: inline-block; color: var(--bright); font-size: 12px; font-weight: 800; margin-top: 10px; }

.trust-cards { display: grid; gap: 12px; }

.trust-cards article { padding: 19px 20px; border: 1px solid var(--line); border-radius: 10px; }

.trust-cards b { font: 700 13px Manrope; color: var(--navy); }

.trust-cards p { font-size: 11px; line-height: 1.6; color: rgb(122, 137, 155); margin: 8px 0px 0px; }

.cta { margin: 0px 8.5% 75px; padding: 34px 42px; border-radius: 14px; background: var(--navy); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: space-between; }

.cta .eyebrow { color: rgb(142, 190, 255); }

.cta h2 { font: 800 24px Manrope; margin: 10px 0px; }

.cta p { color: rgb(182, 196, 216); font-size: 12px; margin: 0px; }

.cta .primary { background: rgb(255, 255, 255); color: var(--navy); box-shadow: none; }

.terms { padding: 65px 9%; background: rgb(247, 249, 252); }

.terms h2 { margin-bottom: 8px; }

.muted { font-size: 12px; line-height: 1.6; color: rgb(120, 135, 154); max-width: 700px; }

.terms-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 25px; }

.terms-grid article { background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 9px; padding: 17px; }

.terms-grid h3 { font: 700 12px Manrope; color: var(--navy); }

.terms-grid p, .terms-note { font-size: 10px; line-height: 1.7; color: rgb(122, 137, 155); }

.terms-note { margin-top: 18px; }

footer { padding: 30px 7%; display: flex; align-items: center; justify-content: space-between; gap: 20px; }

footer > span { font-size: 10px; color: rgb(138, 152, 169); }

footer > div { display: flex; gap: 18px; font-size: 11px; font-weight: 700; color: rgb(101, 117, 138); }

.modal-backdrop { display: none; position: fixed; inset: 0px; background: rgba(6, 23, 45, 0.8); z-index: 30; align-items: center; justify-content: center; padding: 20px; }

.modal-backdrop.show { display: flex; }

.modal { background: rgb(255, 255, 255); border-radius: 15px; width: min(570px, 100%); max-height: 90vh; overflow: auto; padding: 30px; position: relative; box-shadow: rgba(0, 0, 0, 0.267) 0px 25px 90px; }

.close { position: absolute; right: 18px; top: 12px; border: 0px; background: none; font-size: 27px; color: rgb(130, 144, 162); cursor: pointer; }

.modal h2 { font: 800 23px Manrope; color: var(--navy); margin: 0px 30px 8px 0px; }

.modal p { font-size: 12px; line-height: 1.6; color: rgb(119, 134, 154); }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

.field { display: grid; gap: 6px; margin: 12px 0px; }

.field.full-field { grid-column: 1 / -1; }

.field label { font-size: 10px; font-weight: 800; color: rgb(82, 100, 124); }

.field input, .field select, .field textarea { border: 1px solid rgb(220, 228, 238); border-radius: 7px; padding: 12px; font: 12px "DM Sans"; outline-color: rgb(139, 183, 237); width: 100%; }

.field textarea { min-height: 80px; resize: vertical; }

.fee-box { background: rgb(241, 246, 252); padding: 12px; border-radius: 8px; font-size: 11px; color: rgb(83, 103, 127); line-height: 1.6; margin: 12px 0px; }

.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }

.toast { position: fixed; bottom: 25px; right: 25px; background: var(--navy); color: rgb(255, 255, 255); padding: 13px 18px; border-radius: 8px; font-size: 12px; opacity: 0; transform: translateY(10px); transition: 0.25s; z-index: 50; pointer-events: none; }

.toast.show { opacity: 1; transform: translateY(0px); }

.chat-box { border: 1px solid var(--line); border-radius: 9px; overflow: hidden; margin-top: 15px; }

