  0% { opacity: 0; transform: translateY(8px); }
}

.prose-review-bar-enter { animation: prose-review-bar-in var(--cds-dur-base,.2s) var(--cds-ease-out,cubic-bezier(.165, .84, .44, 1)) both; }

